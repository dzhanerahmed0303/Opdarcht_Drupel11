<article{{ attributes.addClass('node', 'node--type-article', 'node--teaser') }}>
  {% if content.field_image %}
    <div class="teaser__image">{{ content.field_image }}</div>
  {% endif %}
  <div class="teaser__body">
    <h3 class="teaser__title">
      <a href="{{ url }}" rel="bookmark">{{ label }}</a>
    </h3>
    {% if content.body %}
      <div class="teaser__excerpt">{{ content.body }}</div>
    {% endif %}
    {% if content.field_tags %}
      <div class="teaser__tags">{{ content.field_tags }}</div>
    {% endif %}
  </div>
</article>
