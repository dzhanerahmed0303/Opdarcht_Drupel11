{# Office detail page — wireframe page 7 #}
<article{{ attributes.addClass('node', 'node--type-office', 'node--full') }}>

  <div class="node__inner">
    <div class="back-link">
      <a href="/offices">&lt; {{ 'back to overview'|t }}</a>
    </div>

    <h1>{{ label }}</h1>

    {# Two-column: large image left, contact details right #}
    <div class="node__columns node__columns--office">
      <div class="node__col-image">
        {{ content.field_office_image }}
      </div>
      <div class="node__col-body">
        {% if content.field_telephone %}
          <div class="office-detail">
            <strong>{{ 'Tel'|t }}:</strong>
            {{ content.field_telephone }}
          </div>
        {% endif %}
        {% if content.field_fax %}
          <div class="office-detail">
            <strong>{{ 'Fax'|t }}:</strong>
            {{ content.field_fax }}
          </div>
        {% endif %}
        {% if content.field_address %}
          <div class="office-detail">
            <strong>{{ 'Adres'|t }}:</strong>
            {{ content.field_address }}
          </div>
        {% endif %}
        {% if content.field_email %}
          <div class="office-detail">
            <strong>{{ 'Email'|t }}:</strong>
            {{ content.field_email }}
          </div>
        {% endif %}
        {% if content.field_context_person %}
          <div class="office-detail">
            <strong>{{ 'Contact person'|t }}:</strong>
            {{ content.field_context_person }}
          </div>
        {% endif %}
      </div>
    </div>
  </div>

  {# Articles from this office #}
  <div class="node__related">
    <div class="node__related-header">
      <h2>{{ 'Articles from'|t }} {{ label }}</h2>
      <a href="/articles" class="more-link">{{ 'more articles'|t }} &gt;</a>
    </div>
    <div class="node__related-grid">
      {{ drupal_view('articles', 'block_from_office', node.id) }}
    </div>
  </div>

</article>
