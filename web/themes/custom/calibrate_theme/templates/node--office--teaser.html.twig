<article{{ attributes.addClass('node', 'node--type-office', 'node--teaser') }}>
  {% if content.field_office_image %}
    <div class="teaser__image">
      <a href="{{ url }}" tabindex="-1" aria-hidden="true">
        {{ content.field_office_image }}
      </a>
    </div>
  {% endif %}
  <div class="teaser__body">
    <h3 class="teaser__title">
      <a href="{{ url }}" rel="bookmark">{{ label }}</a>
    </h3>
    {% if content.field_country %}
      <div class="teaser__country">{{ content.field_country }}</div>
    {% endif %}
  </div>
</article>
